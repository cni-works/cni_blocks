{
  "apiVersion": 3,
  "name": "cni-blocks/heading-plus",
  "title": "見出し+",
  "category": "cni-blocks",
  "icon": "heading",
  "description": "端末別の文字サイズ、Google Fonts、テキストデザインを設定できる見出しです。",
  "keywords": [ "見出し", "タイトル", "Google Fonts", "文字装飾", "テキストデザイン" ],
  "textdomain": "cni-blocks",
  "attributes": {
    "content": { "type": "string", "source": "html", "selector": ".cni-heading-plus__text", "default": "" },
    "level": { "type": "number", "default": 2 },
    "tagName": { "type": "string", "default": "" },
    "marginTop": { "type": "number" },
    "marginBottom": { "type": "number" },
    "legacyLayout": { "type": "boolean", "default": false },
    "layoutVersion": { "type": "number", "default": 2 },
    "inlineImageId": { "type": "number", "default": 0 },
    "inlineImageUrl": { "type": "string", "default": "" },
    "inlineImageAlt": { "type": "string", "default": "" },
