    "cardPaddingVerticalPc": {
      "type": "number",
      "default": -1
    },
    "cardPaddingHorizontalPc": {
      "type": "number",
      "default": -1
    },
    "cardPaddingVerticalTablet": {
      "type": "number",
      "default": -1
    },
    "cardPaddingHorizontalTablet": {
      "type": "number",
      "default": -1
    },
    "cardPaddingVerticalMobile": {
      "type": "number",
      "default": -1
