{
  "apiVersion": 3,
  "name": "cni-blocks/auto-grid",
  "title": "Grid+",
  "category": "cni-blocks",
  "icon": "grid-view",
  "description": "カードの最小幅から列数を自動計算するレスポンシブグリッド。",
  "textdomain": "cni-blocks",
  "attributes": {
    "minWidthPc": {
      "type": "number",
      "default": 280
