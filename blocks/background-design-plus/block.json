    "paddingHorizontalPc": { "type": "number" },
    "paddingVerticalTablet": { "type": "number" },
    "paddingHorizontalTablet": { "type": "number" },
    "paddingVerticalMobile": { "type": "number" },
    "paddingHorizontalMobile": { "type": "number" },
    "paddingY": { "type": "number", "default": 88 },
    "paddingX": { "type": "number", "default": 32 },
    "contentWidth": { "type": "number", "default": 1200 },
    "contentAlign": { "type": "string", "default": "left" },
