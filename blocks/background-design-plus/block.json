    "baseColor": { "type": "string", "default": "#f8fafc" },
    "color1": { "type": "string", "default": "#60a5fa" },
    "color2": { "type": "string", "default": "#c084fc" },
    "color3": { "type": "string", "default": "#f9a8d4" },
    "color4": { "type": "string", "default": "#fcd34d" },
    "color5": { "type": "string", "default": "#34d399" },
